{
  "name": "vieclambaove",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "data:pull": "node scripts/pull-data.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vieclambaove --local",
    "db:migrate:remote": "wrangler d1 migrations apply vieclambaove --remote"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
