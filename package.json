{
  "name": "vieclambaove",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/build.sh",
    "dev": "sh scripts/build.sh && wrangler dev",
    "deploy": "sh scripts/build.sh && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vieclambaove --local",
    "db:migrate:remote": "wrangler d1 migrations apply vieclambaove --remote"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}
