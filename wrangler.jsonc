{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vieclambaove",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // URL sạch không phải file → index.html cho router JS xử lý
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    // Các đường dẫn Worker xử lý trước (API, dữ liệu, SEO); còn lại phục vụ file tĩnh trực tiếp
    "run_worker_first": ["/api/*", "/data/*", "/robots.txt", "/sitemap.xml", "/", "/viec-lam", "/viec-lam/*", "/tin/*", "/cong-ty/*", "/video", "/video/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "vieclambaove", "database_id": "cda8c87a-8005-4c6d-b325-a2fa70009782", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    // Giấy tờ xác thực công ty (không công khai)
    { "binding": "FILES", "bucket_name": "vieclambaove-files" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
  // Secret (đặt bằng `wrangler secret put`): ADMIN_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
